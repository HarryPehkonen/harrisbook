# Harrisbook — copy to .env for local dev (never commit .env).

# Postgres — app DB owned by role hb_user
DATABASE_URL=postgres://hb_user:hb_dev_local@localhost:5432/harrisbook?sslmode=disable

# HTTP
PORT=8091
HOST=127.0.0.1

# Google OAuth (GUI sign-in). Create an OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8091/api/auth/callback

# Comma-separated allowlist — only these emails may sign in to the GUI (v1).
ADMIN_EMAILS=harry.pehkonen@gmail.com

# Tests use this (defaults to the value below if unset):
# DATABASE_URL_TEST=postgres://hb_user:hb_dev_local@localhost:5432/harrisbook_test?sslmode=disable
