{
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read api/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read tests/"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
